# --- Python bytecode / cache ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Build / packaging ---
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Django ---
*.log
debug.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Type check / lint cache ---
.mypy_cache/
.pyre/
.ruff_cache/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local env / secrets ---
.env
.env.*
*.local

# --- Node (if frontend tooling appears) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Temporary / backup ---
*.tmp
*.temp
*.bak
*.orig
